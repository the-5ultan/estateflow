VITE_BRAND_NAME=EstateFlow
# Relative API path keeps local session requests on the Vite proxy's origin.
VITE_API_BASE_URL=/api/v1
# Development only: change this if port 8080 is occupied.
BACKEND_PROXY_TARGET=http://localhost:8080
# Optional, licensed, self-hosted replacements. Empty values use the supplied design reference.
VITE_HERO_POSTER_URL=
VITE_HERO_VIDEO_URL=
# Set false before production unless rights to reference media have been confirmed.
VITE_USE_REFERENCE_MEDIA=true
